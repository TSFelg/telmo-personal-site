---
import type { HTMLAttributes } from "astro/types";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
  data-pagefind-ignore
>
  <div class="site-footer">
    <span>© {new Date().getFullYear()} {config.site.author}</span>
    <div>
      <a href={getAssetPath("rss.xml")}>RSS</a><span aria-hidden="true">
        ·
      </span><a href="https://github.com/satnaing/astro-paper">AstroPaper</a>
    </div>
  </div>
</footer>
