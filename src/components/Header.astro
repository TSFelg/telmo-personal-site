---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { stripBase } from "@/utils/withBase";
import { postFilter } from "@/utils/postFilter";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const path = stripBase(Astro.url.pathname);
const hasPosts = (await getCollection("posts")).some(postFilter);
const links = [
  ["Talks", "talks"],
  ...(hasPosts ? [["Posts", "posts"]] : []),
  ...(hasPosts && config.features.showArchives
    ? [["Archive", "archives"]]
    : []),
  ["Search", "search"],
  ...(hasPosts ? [["Tags", "tags"]] : []),
  ["About", "about"],
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="app-layout" data-pagefind-ignore>
  <div class="site-header">
    <a class="site-name" href={getRelativeLocaleUrl(locale, "")}
      >{config.site.title}</a
    >
    <nav aria-label="Main navigation">
      {
        links.map(([label, slug]) => (
          <a
            href={getRelativeLocaleUrl(locale, slug)}
            aria-current={path.startsWith(`/${slug}`) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
