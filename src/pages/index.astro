---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Socials from "@/components/Socials.astro";
import TalkList from "@/components/TalkList.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { sortTalks } from "@/utils/talks";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const talks = sortTalks(await getCollection("talks"));
const posts = getSortedPosts(await getCollection("posts"));
const url = (path: string) => getRelativeLocaleUrl(locale, path);
---

<Layout title="Telmo · Talks & notes">
  <Header />
  <main id="main-content" class="app-layout home-content" tabindex="-1">
    <section class="intro" aria-labelledby="hello">
      <h1 id="hello">Hi, I’m Telmo.</h1>
      <p>This is my home for talks, slides and technical notes.</p>
      {config.socials.length > 0 && <Socials />}
    </section>
    <section class="home-section" aria-labelledby="talks-heading">
      <div class="section-heading">
        <h2 id="talks-heading">Talks</h2><a href={url("talks")}>All talks →</a>
      </div>
      {
        talks.length > 0 ? (
          <TalkList talks={talks.slice(0, 5)} />
        ) : (
          <p class="empty-note">
            I’m gathering my slides and recordings. They’ll appear here soon.
          </p>
        )
      }
    </section>
    {
      posts.length > 0 && (
        <section class="home-section" aria-labelledby="posts-heading">
          <div class="section-heading">
            <h2 id="posts-heading">Posts</h2>
            <a href={url("posts")}>All posts →</a>
          </div>
          <ul>
            {posts.slice(0, config.posts.perIndex).map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
